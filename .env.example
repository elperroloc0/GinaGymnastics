# Copy to .env on the VPS and fill in real values. This root .env feeds
# docker compose (service vars + ${...} substitution in compose.yaml);
# it is separate from backend/.env, which is only for running Django
# outside Docker.

# --- Postgres ---
POSTGRES_DB=ginagymnastics
POSTGRES_USER=gina
POSTGRES_PASSWORD=changeme

# --- Caddy (automatic HTTPS needs a real, publicly resolvable domain) ---
# For local docker-compose verification (no real domain), use DOMAIN=http://localhost
# instead - the explicit http:// scheme tells Caddy to skip automatic HTTPS
# and just serve plain HTTP on :80.
DOMAIN=example.com

# --- Django ---
DJANGO_SECRET_KEY=changeme
DEBUG=False
ALLOWED_HOSTS=example.com

# --- Traccar webhook auth (tracking/views.py _check_secret) ---
TRACCAR_WEBHOOK_SECRET=changeme

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Frontend build (gina-ride-tracker-web/Dockerfile, via the frontend-build
# service below) --- Vite inlines this into the JS bundle at build time, so it
# has to be set before `docker compose up --build`, not changed afterward.
VITE_MAPBOX_TOKEN=
