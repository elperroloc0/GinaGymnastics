# Copy to .env on the VPS and fill in real values. This root .env feeds
# docker compose (service vars + ${...} substitution in compose.yaml);
# it is separate from backend/.env, which is only for running Django
# outside Docker.

# --- Postgres ---
POSTGRES_DB=ginagymnastics
POSTGRES_USER=gina
POSTGRES_PASSWORD=changeme

# --- Caddy (automatic HTTPS needs a real, publicly resolvable domain) ---
# For local docker-compose verification (no real domain), use DOMAIN=http://localhost
# instead - the explicit http:// scheme tells Caddy to skip automatic HTTPS
# and just serve plain HTTP on :80.
DOMAIN=example.com

# --- Django ---
DJANGO_SECRET_KEY=changeme
DEBUG=False
# Also include the frontend's bare domain (e.g. example.vercel.app, no
# scheme) here, not just this API's own domain - channels' WS origin check
# (AllowedHostsOriginValidator, backend/asgi.py) reuses ALLOWED_HOSTS to
# decide which Origin headers may open a /ws/ connection.
ALLOWED_HOSTS=example.com

# Frontend origin(s) allowed to call the API cross-origin (e.g. the Vercel
# deployment). Comma-separated, scheme required, no trailing slash.
CORS_ALLOWED_ORIGINS=https://example.vercel.app

# --- Traccar webhook auth (tracking/views.py _check_secret) ---
TRACCAR_WEBHOOK_SECRET=changeme

# --- Traccar REST API (server-to-server, inside the compose network) ---
# Credentials for a dedicated Traccar user (create one via the SSH-tunneled
# web UI on 8082) used only for geofence provisioning - separate from
# TRACCAR_WEBHOOK_SECRET above, which is for the opposite direction
# (Traccar -> Django webhooks). See backend/fleet/traccar_client.py.
TRACCAR_API_URL=http://traccar:8082
TRACCAR_API_USERNAME=changeme
TRACCAR_API_PASSWORD=changeme

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email (Gmail SMTP) --- alternative to SMS for arrival notifications,
# for a parent whose notify_channel preference is EMAIL (accounts.User).
# myaccount.google.com -> Security -> App Passwords - use an app password
# here, not the real account password (Google blocks plain SMTP login for
# most accounts). EMAIL_HOST_USER also becomes the "From" address.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
