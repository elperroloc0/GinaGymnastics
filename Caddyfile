{$DOMAIN} {
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # This domain is API-only now - the frontend is deployed separately on
    # Vercel and talks to it cross-origin (see VITE_API_URL, CORS_ALLOWED_ORIGINS).
    # Everything below is what Django owns: the API, the webhook endpoints
    # Traccar calls, the admin, the WebSocket upgrade, and DRF's browsable-API
    # login. Caddy proxies a WebSocket upgrade transparently like any other
    # request, so /ws/* needs nothing special beyond being in this matcher.
    @backend path /api/* /webhooks/* /admin/* /ws/* /api-auth/*
    handle @backend {
        reverse_proxy django:8000
    }
}
